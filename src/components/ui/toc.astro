---
import type { MarkdownHeading } from "astro";

interface Props {
    headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<div class="sticky top-18 mt-4 ml-4 hidden max-h-fit min-w-fit flex-col gap-y-3 lg:flex">
    <h3 class:list="text-xl">On This Page</h3>
    {
        headings
            .filter(({ depth }) => depth < 3)
            .map(({ slug, text }) => (
                <a
                    href={`#${slug}`}
                    data-toc={slug}
                    class:list={[
                        "text-sm font-normal text-foreground/70 no-underline transition-colors duration-150 hover:text-foreground data-[active=true]:font-semibold data-[active=true]:text-foreground",
                    ]}
                >
                    • {text}
                </a>
            ))
    }
</div>

<script is:inline>
    // Highlight the heading whose section is currently in view
    (() => {
        const links = [...document.querySelectorAll("[data-toc]")];
        const headings = links.map(link => document.getElementById(link.dataset.toc)).filter(Boolean);
        if (headings.length === 0) return;

        const setActive = id => {
            for (const link of links) link.dataset.active = String(link.dataset.toc === id);
        };

        // The active heading is the last one that has scrolled up to just below the header,
        // or the last heading once the page is scrolled to the bottom
        const update = () => {
            const atBottom =
                Math.ceil(window.scrollY + window.innerHeight) >= document.documentElement.scrollHeight - 2;
            if (atBottom) return setActive(headings[headings.length - 1].id);

            const current = headings.filter(heading => heading.getBoundingClientRect().top <= 120).at(-1);
            setActive(current?.id ?? "");
        };

        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        update();
    })();
</script>
