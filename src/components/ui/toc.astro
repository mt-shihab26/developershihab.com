---
import type { MarkdownHeading } from "astro";

interface Props {
    headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<div class="sticky top-18 mt-4 ml-4 hidden max-h-fit min-w-fit flex-col gap-y-3 lg:flex">
    <h3 class:list="text-xl">On This Page</h3>
    {headings
        .filter(({ depth }) => depth < 3)
        .map(({ slug, text }) => (
            <a
                href={`#${slug}`}
                data-spy={slug}
                class="text-sm font-normal text-foreground/70 no-underline transition-colors duration-150 hover:text-foreground data-[active=true]:font-semibold data-[active=true]:text-brand"
            >
                • {text}
            </a>
        ))}
</div>

<script>
    import "@/scripts/scroll-spy";
</script>
