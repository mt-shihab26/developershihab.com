---
import { ChevronRightIcon } from "lucide-react";

interface Props {
    href: string;
    title: string;
}

const { href, title } = Astro.props;
---

<a {href} class="group flex w-full cursor-pointer items-center">
    <slot name="icon" />
    <div class="flex flex-1 flex-col items-start justify-center gap-3 border-l p-4">
        <div class="flex w-full items-center justify-between text-left select-none">
            <h3 class="text-lg font-semibold underline-offset-6 group-hover:underline">{title}</h3>
            <ChevronRightIcon className="size-4 shrink-0 text-muted-foreground transition-transform duration-150 group-hover:translate-x-1" />
        </div>
        <slot />
    </div>
</a>
