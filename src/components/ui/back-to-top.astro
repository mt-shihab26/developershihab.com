---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

import { ChevronUp } from "lucide-react";
---

<button
    id="back-to-top"
    aria-label="Back to top"
    title="Back to top"
    class={cn(
        buttonVariants({ size: "icon" }),
        "fixed right-4 bottom-[4rem] z-50 scale-0 cursor-pointer rounded-full transition-transform duration-150 lg:left-[calc(100vw/2+400px)]"
    )}
>
    <ChevronUp />
</button>

<script is:inline>
    // Show the button once the page is scrolled past one screen
    (() => {
        const button = document.getElementById("back-to-top");

        const update = () => button.classList.toggle("scale-0", window.scrollY < window.innerHeight);

        button.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
        window.addEventListener("scroll", update, { passive: true });
        update();
    })();
</script>
