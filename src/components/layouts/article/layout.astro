---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";

import { devTo as devToProfile } from "@/lib/information";
import { SEPARATOR, capitalizeFirstLetter, getReadingTime } from "@/lib/utils";

import BoxHeader from "@/components/ui/box-header.astro";
import Box from "@/components/ui/box-index.astro";
import BoxTitle from "@/components/ui/box-title.astro";
import Pattern from "@/components/ui/pattern.astro";
import Prose from "@/components/ui/prose.astro";
import Published from "@/components/ui/published.astro";

import BaseLayout from "@/components/layouts/base/layout.astro";

interface Props {
    article: CollectionEntry<"articles">;
    headings: MarkdownHeading[];
}

const { article, headings } = Astro.props;
const { title, description, pubDatetime, updatedDatetime, devTo } = article.data;
---

<BaseLayout title={title} description={description} ogImage={`/og/articles/${article.id}.png`} backLink="/articles">
    <Box>
        <BoxHeader class="flex items-center justify-between text-sm !font-medium text-muted-foreground">
            <div>
                <Published pubDatetime={pubDatetime} updatedDatetime={updatedDatetime} />
                {` ${SEPARATOR} `}
                {getReadingTime(article.body)}
            </div>
            {devTo && (
                <div class="flex space-x-1">
                    <span>also published at</span>
                    <a href={devToProfile + devTo} target="_blank" class="underline underline-offset-2">
                        dev.to
                    </a>
                </div>
            )}
        </BoxHeader>
        <Pattern className="screen-line-after" />
        <BoxHeader>
            <BoxTitle className="text-2xl !font-black md:text-3xl">{capitalizeFirstLetter(title)}</BoxTitle>
        </BoxHeader>
        <Pattern />
    </Box>
    <Prose headings={headings}>
        <slot />
    </Prose>
</BaseLayout>
