---
import { formatCapitalized } from "@/lib/formats";

import BoxContent from "@/components/ui/box-content.astro";
import BoxHeader from "@/components/ui/box-header.astro";
import Box from "@/components/ui/box-index.astro";
import BoxTitle from "@/components/ui/box-title.astro";

import BaseLayout from "@/components/layouts/base-layout.astro";

interface Props {
    title: string;
    description: string;
    backLink?: string;
    ogImage?: string;
}

const { title, description, backLink, ogImage } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} backLink={backLink}>
    <Box>
        <BoxHeader>
            <BoxTitle className="text-2xl !font-black">{formatCapitalized(title)}</BoxTitle>
        </BoxHeader>
        <BoxContent>{description}</BoxContent>
    </Box>
    <slot />
</BaseLayout>
