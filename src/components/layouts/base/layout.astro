---
import { name } from "@/lib/information";

import { ArrowLeft } from "lucide-react";

import LinkBtn from "@/components/ui/link-btn.astro";
import Pattern from "@/components/ui/pattern.astro";

import SiteFooter from "@/components/layouts/site/footer.astro";
import SiteHeader from "@/components/layouts/site/header.astro";
import SiteLayout from "@/components/layouts/site/layout.astro";

interface Props {
    title: string;
    description: string;
    ogImage?: string;
    backLink?: string;
    backLabel?: string;
}

const { title, description, ogImage, backLink, backLabel = "Back link" } = Astro.props;
---

<SiteLayout title={`${title} - ${name}`} description={description} ogImage={ogImage}>
    <SiteHeader />
    <main class="mx-auto min-h-screen max-w-3xl" aria-label="Main content">
        <Pattern className="h-14">
            <div class="z-1 mx-2 mt-auto flex w-full items-center justify-between">
                {backLink && (
                    <LinkBtn ariaLabel={backLabel} href={backLink}>
                        <ArrowLeft />
                    </LinkBtn>
                )}
                <div>
                    <slot name="actions" />
                </div>
            </div>
        </Pattern>
        <slot />
        <Pattern />
    </main>
    <SiteFooter />
</SiteLayout>
