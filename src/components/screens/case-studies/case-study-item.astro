---
import type { CollectionEntry } from "astro:content";

import { BookOpenTextIcon } from "lucide-react";

import ListItem from "@/components/ui/list-item.astro";

interface Props {
    caseStudy: CollectionEntry<"case_studies">;
}

const { caseStudy } = Astro.props;
const { title, description, logo, logo_alt } = caseStudy.data;
---

<ListItem href={`/case-studies/${caseStudy.id}`} title={title}>
    {logo ? (
        <img
            slot="icon"
            src={logo.src}
            alt={logo_alt ?? `${title} logo`}
            class="mx-3 size-9 shrink-0 object-contain"
            loading="lazy"
        />
    ) : (
        <BookOpenTextIcon slot="icon" className="mx-4.5 size-5 shrink-0 text-muted-foreground" />
    )}
    <p class="text-xs leading-5 font-medium md:text-sm">{description}</p>
</ListItem>
