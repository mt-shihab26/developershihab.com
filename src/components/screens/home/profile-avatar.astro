---
import avatar from "@/assets/images/avatar.png";
import { name } from "@/content/information";

import { Picture } from "astro:assets";

interface Props {
    className?: string;
    size?: number;
    priority?: boolean;
}

const { className, size = 100, priority = false } = Astro.props;

const formats = ["avif", "webp"];
---

<Picture
    class:list={[className]}
    src={avatar}
    widths={[size, size * 2]}
    sizes={`(max-width: ${size}px) 100vw, ${size}px`}
    formats={formats}
    alt={`${name}'s avatar`}
    quality="mid"
    loading={priority ? "eager" : "lazy"}
    decoding="async"
/>
