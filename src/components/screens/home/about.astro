---
import { getExperienceYears } from "@/content/experiences";

import BoxContent from "@/components/ui/box-content.astro";
import BoxHeader from "@/components/ui/box-header.astro";
import Box from "@/components/ui/box-index.astro";
import BoxTitle from "@/components/ui/box-title.astro";
---

<Box>
    <BoxHeader>
        <BoxTitle> About </BoxTitle>
    </BoxHeader>
    <BoxContent>
        <div class="text-sm leading-7 font-medium">
            I am a <b>software engineer</b> with <b>{getExperienceYears()}+ years</b> of professional experience,
            passionate about building and scaling high-quality software solutions. With expertise in <b>full-stack</b>{" "}
            development, I deliver software quickly with clean, maintainable code patterns. Always <b>learning</b>,
            always <b>iterating</b>, always pushing boundaries.
        </div>
    </BoxContent>
</Box>
