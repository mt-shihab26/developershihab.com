---
import { email, twitter, linkedin, github } from "@/lib/information";
import { pages } from "@/lib/pages";

import { Check, Copy, Mail } from "lucide-react";

import GithubIcon from "@/components/icons/github.astro";
import LinkedinIcon from "@/components/icons/linkedin.astro";
import XIcon from "@/components/icons/x.astro";

import BoxContent from "@/components/ui/box-content.astro";
import BoxHeader from "@/components/ui/box-header.astro";
import Box from "@/components/ui/box-index.astro";
import BoxTitle from "@/components/ui/box-title.astro";

import PageLayout from "@/components/layouts/page/layout.astro";
---

<PageLayout title={pages.contact.title} description={pages.contact.description} ogImage="/og/contact.png">
    <Box>
        <BoxHeader>
            <BoxTitle>Reach out</BoxTitle>
        </BoxHeader>
        <BoxContent className="space-y-4">
            <p class="text-sm text-muted-foreground">
                Open to contract work building web applications. I usually reply within a day.
            </p>
            <div class="flex items-center gap-3 pb-2">
                <a
                    href={`mailto:${email}`}
                    class="flex min-w-0 items-center gap-3 rounded-md transition-colors hover:text-primary"
                >
                    <Mail className="size-6 shrink-0 md:size-7" />
                    <span class="text-xl font-bold break-all md:text-3xl">{email}</span>
                </a>
                <button
                    type="button"
                    data-copy-email={email}
                    aria-label="Copy email address"
                    title="Copy email address"
                    class="group/copy inline-flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-md border text-muted-foreground transition-colors hover:text-foreground"
                >
                    <Copy className="size-4 group-data-[copied=true]/copy:hidden" />
                    <Check className="hidden size-4 text-green-600 group-data-[copied=true]/copy:block" />
                </button>
                <span data-copy-status class="sr-only" aria-live="polite"></span>
                <script is:inline>
                    (() => {
                        const button = document.querySelector("[data-copy-email]");
                        const status = document.querySelector("[data-copy-status]");
                        let timer;

                        button.addEventListener("click", async () => {
                            try {
                                await navigator.clipboard.writeText(button.dataset.copyEmail);
                            } catch {
                                return;
                            }

                            button.dataset.copied = "true";
                            status.textContent = "Email address copied";

                            clearTimeout(timer);
                            timer = setTimeout(() => {
                                delete button.dataset.copied;
                                status.textContent = "";
                            }, 2000);
                        });
                    })();
                </script>
            </div>

            <a
                href={linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 rounded-md transition-colors hover:text-primary"
            >
                <LinkedinIcon className="size-4 shrink-0" />
                <span>linkedin.com/in/mt-shihab26</span>
            </a>

            <a
                href={twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 rounded-md transition-colors hover:text-primary"
            >
                <XIcon className="size-4 shrink-0" />
                <span>x.com/mt_shihab26</span>
            </a>

            <a
                href={github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 rounded-md transition-colors hover:text-primary"
            >
                <GithubIcon className="size-4 shrink-0" />
                <span>github.com/mt-shihab26</span>
            </a>
        </BoxContent>
    </Box>
</PageLayout>
