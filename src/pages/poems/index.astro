---
import { getPoems } from "@/lib/content";

import PageLayout from "@/components/layouts/page-layout.astro";
import PoemItem from "@/components/screens/poems/poem-item.astro";
import BoxHeader from "@/components/ui/box-header.astro";
import Box from "@/components/ui/box-index.astro";
import BoxTitle from "@/components/ui/box-title.astro";
import Pattern from "@/components/ui/pattern.astro";

const poems = await getPoems();
export const meta = {
    title: "Poems",
    description:
        "A collection of my Bengali poems — verses on love, longing, gratitude, and the quiet things of the heart.",
};
---

<PageLayout title={meta.title} description={meta.description} ogImage="/og/poems.png">
    <Pattern />
    <Box>
        <BoxHeader>
            <BoxTitle>Poems</BoxTitle>
        </BoxHeader>
        <div class="flex w-full flex-col items-start justify-start divide-y divide-border">
            {poems.map(poem => (
                <PoemItem poem={poem} />
            ))}
        </div>
    </Box>
</PageLayout>
