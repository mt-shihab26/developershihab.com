---
import { PROJECT_CATEGORIES } from "@/lib/projects";

import { pages } from "@/lib/pages";
import { getProjectsByCategory } from "@/lib/projects";

import PageLayout from "@/components/layouts/page-layout/index.astro";
import ProjectsList from "@/components/screens/projects/projects-list.astro";
import SectionNav from "@/components/ui/section-nav.astro";

const { professional, openSource, personal } = getProjectsByCategory();

const sections = [
    { id: "production-saas-products", label: PROJECT_CATEGORIES.professional, projects: professional },
    { id: "side-projects", label: PROJECT_CATEGORIES.personal, projects: personal },
    { id: "open-source-tools-and-plugins", label: PROJECT_CATEGORIES.openSource, projects: openSource },
].filter(section => section.projects.length > 0);
---

<PageLayout title={pages.projects.title} description={pages.projects.description} ogImage="/og/projects.png">
    {sections.map(section => (
        <div id={section.id} class="scroll-mt-12">
            <ProjectsList title={section.label} projects={section.projects} />
        </div>
    ))}
    <SectionNav sections={sections} />
</PageLayout>
