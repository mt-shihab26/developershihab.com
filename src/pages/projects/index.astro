---
import { projectCategories } from "@/content/projects";

import { getProjectsByCategory } from "@/content/projects";

import PageLayout from "@/components/layouts/page-layout/index.astro";
import ProjectsList from "@/components/screens/projects/projects-list.astro";
import SectionNav from "@/components/ui/section-nav.astro";

const { professional, openSource, personal } = getProjectsByCategory();

const sections = [
    { id: "production-saas-products", label: projectCategories.professional, projects: professional },
    { id: "side-projects", label: projectCategories.personal, projects: personal },
    { id: "open-source-tools-and-plugins", label: projectCategories.openSource, projects: openSource },
].filter(section => section.projects.length > 0);
export const meta = {
    title: "My Projects",
    description: "Production SaaS products, side projects, and open source tools I have built.",
};
---

<PageLayout title={meta.title} description={meta.description} ogImage="/og/projects.png">
    {sections.map(section => (
        <div id={section.id} class="scroll-mt-12">
            <ProjectsList title={section.label} projects={section.projects} />
        </div>
    ))}
    <SectionNav sections={sections} />
</PageLayout>
