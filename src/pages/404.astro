---
import { getArticles } from "@/lib/content";

import { ChevronRightIcon } from "lucide-react";

import PageLayout from "@/components/layouts/page-layout/index.astro";
import ArticleList from "@/components/ui/article-list.astro";
import BoxHeader from "@/components/ui/box-header.astro";
import Box from "@/components/ui/box-index.astro";
import BoxTitle from "@/components/ui/box-title.astro";
import Pattern from "@/components/ui/pattern.astro";

const latestArticles = (await getArticles()).slice(0, 1);

const links = [
    { label: "Case Studies", description: "How I built and run my SaaS products", href: "/case-studies" },
    { label: "Projects", description: "Everything I have built", href: "/projects" },
    { label: "Articles", description: "Everything I have written", href: "/articles" },
    { label: "Home", description: "Start from the beginning", href: "/" },
];
export const meta = {
    title: "Page not found",
    description: "This page doesn't exist, or it moved. Here are a few places to go instead.",
};
---

<PageLayout title={meta.title} description={meta.description}>
    {latestArticles.length > 0 && <ArticleList title="Latest article" articles={latestArticles} />}

    <Pattern />
    <Box>
        <BoxHeader>
            <BoxTitle>Or try one of these</BoxTitle>
        </BoxHeader>
        {links.map(link => (
            <a href={link.href} class="group flex w-full items-center justify-between border-t px-4 py-3">
                <span>
                    <span class="font-semibold underline-offset-4 group-hover:underline">{link.label}</span>
                    <span class="block text-xs text-muted-foreground">{link.description}</span>
                </span>
                <ChevronRightIcon className="size-4 shrink-0 text-muted-foreground transition-transform duration-150 group-hover:translate-x-1" />
            </a>
        ))}
    </Box>
</PageLayout>
