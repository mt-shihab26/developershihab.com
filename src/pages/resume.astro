---
import { name } from "@/lib/information";
import { pages } from "@/lib/pages";

import Back from "@/components/ui/back.astro";
import DownloadButton from "@/components/ui/download-button.astro";

import SiteLayout from "@/components/layouts/site/layout.astro";
import ModeToggle from "@/components/layouts/site/mode-toggle.astro";

import { Resume as ResumeComponent } from "@/components/screens/resume";
---

<SiteLayout title={`${pages.resume.title} - ${name}`} description={pages.resume.description}>
    <div class="mx-auto max-w-[8.3in] space-y-4 px-4 pt-4 pb-12 sm:px-0">
        <div class="flex justify-between sm:px-8">
            <Back />
            <div class="space-x-2">
                <DownloadButton />
                <ModeToggle />
            </div>
        </div>

        <!--
            The resume is always laid out at full A4 width, like the PDF. On narrow screens it is
            scaled down to fit, like a print preview, instead of reflowing into a different layout.
        -->
        <div id="resume-frame" class="relative w-full overflow-hidden">
            <div
                id="resume-page"
                class="w-[8.3in] origin-top-left border bg-white p-[.5in] text-gray-900 dark:bg-black dark:text-white"
            >
                <ResumeComponent />
            </div>
        </div>

        <script is:inline>
            (() => {
                const frame = document.getElementById("resume-frame");
                const page = document.getElementById("resume-page");

                // Fit the A4 page to the available width and give the frame the scaled height
                const fit = () => {
                    const scale = Math.min(1, frame.clientWidth / page.offsetWidth);
                    page.style.transform = scale < 1 ? `scale(${scale})` : "";
                    frame.style.height = `${page.offsetHeight * scale}px`;
                };

                fit();
                new ResizeObserver(fit).observe(frame);
            })();
        </script>
    </div>
</SiteLayout>
