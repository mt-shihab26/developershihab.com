---
import { getArticles, getCategories } from "@/lib/content";

import ArticleList from "@/components/ui/article-list.astro";

import PageLayout from "@/components/layouts/page-layout/index.astro";

export async function getStaticPaths() {
    return getCategories(await getArticles()).map(category => ({ params: { category } }));
}

const { category } = Astro.params;

const articles = (await getArticles()).filter(article => article.data.category === category);

export const getMeta = (category: string) => {
    return {
        title: category,
        description: `Exploring ${category} insights, lessons, and discoveries from my programming journey.`,
    };
};

const { title, description } = getMeta(category);
---

<PageLayout
    backLink="/articles"
    description={description}
    title={title}
    ogImage={`/og/articles/categories/${category}.png`}
>
    <ArticleList articles={articles} />
</PageLayout>
