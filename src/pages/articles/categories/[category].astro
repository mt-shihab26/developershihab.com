---
import { getCollection } from "astro:content";

import { byNewest } from "@/lib/dates";
import { categoryPage } from "@/lib/pages";

import ArticleItem from "@/components/ui/article-item.astro";

import Pattern from "@/components/ui/pattern.astro";
import Box from "@/components/ui/box-index.astro";
import BoxTitle from "@/components/ui/box-title.astro";
import BoxHeader from "@/components/ui/box-header.astro";

import PageLayout from "@/components/layouts/page/layout.astro";

export async function getStaticPaths() {
    const articles = await getCollection("articles", ({ data }) => !data.draft);
    return articles.map(article => ({
        params: { category: article.data.category },
    }));
}

const { category } = Astro.params;

const articles = await getCollection("articles", ({ data }) => !data.draft);
const categoryArticles = articles.filter(article => article.data.category === category).sort(byNewest);

// Page properties
const { title, description } = categoryPage(category);
---

<PageLayout
    backLink="/articles"
    description={description}
    title={title}
    ogImage={`/og/articles/categories/${category}.png`}
>
    <Pattern />

    <Box>
        <BoxHeader>
            <BoxTitle>Articles</BoxTitle>
        </BoxHeader>
        <div class="flex w-full flex-col items-start justify-start divide-y divide-border">
            {categoryArticles.map(article => <ArticleItem article={article} />)}
        </div>
    </Box>
</PageLayout>
