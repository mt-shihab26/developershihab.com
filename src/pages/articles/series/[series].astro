---
import { getArticles, getSeries } from "@/lib/content";

import ArticleList from "@/components/ui/article-list.astro";

import PageLayout from "@/components/layouts/page-layout/index.astro";

export async function getStaticPaths() {
    return getSeries(await getArticles()).map(series => ({ params: { series } }));
}

const { series } = Astro.params;

const articles = (await getArticles()).filter(article => article.data.series === series);

export const getMeta = (series: string) => {
    return {
        title: series,
        description: `Deep dive into ${series} — a curated series from my programming journey.`,
    };
};

const { title, description } = getMeta(series);
---

<PageLayout backLink="/articles" description={description} title={title} ogImage={`/og/articles/series/${series}.png`}>
    <ArticleList articles={articles} />
</PageLayout>
